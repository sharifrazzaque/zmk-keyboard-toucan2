#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings =
                <&kp>,
                <&kp>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&hm RGUI SEMI>, <&kp SQT>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTRL TAB>, <&kp ESC>;
        };

    };


    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // holding down both shift keys to toggle CAPS LOCK
        combo_cword {
            timeout-ms = <50>;
            key-positions = <16 19>; 
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
   //             &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   //             &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   //             &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
   //                             &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
            
            //TODO add ZMK studio unlock key
            //TODO right- and left-most column keys
           
                &none       &kp Q       &kp W        &kp E         &kp R      &kp T        &kp Y         &kp U           &kp I       &kp O  &kp P  &none
                &none  &hm LCMD A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F      &kp G        &kp H  &hm RSHIFT J     &hm RCTRL K  &hm RALT L  &td0  &none
                &none       &kp Z       &kp X        &kp C         &kp V      &kp B        &kp N         &kp M       &kp COMMA     &kp DOT  &kp FSLH  &none
                                     &td1  &lt NAV BSPC  &kp SPACE    &kp ENTER   &lt SYM DEL  &kp BSPC
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
   //             &kp TAB     &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   //             &bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   //             &kp LSHFT   &studio_unlock  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
   //                                             &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
     
   // TODO do I need &mo ADJ for the middle thumb button on right side? Or does &trans work, because of the conditional layers above? 
                &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &kp N6          &kp N7           &kp N8    &kp N9         &kp N0  &none
                &none   &none   &none   &none   &none   &none             &none    &kp UP            &none  &kp HOME      &kp PG_UP  &none
                &none   &none   &none   &none   &none   &none    &kp LEFT_ARROW  &kp DOWN  &kp RIGHT_ARROW   &kp END  &kp PAGE_DOWN  &none
                       &trans  &trans  &trans            &trans  &trans           &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
            //    &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
            //   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
            //    &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
            //                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT

            // TODO do I need &mo ADJ for the middle thumb button on left side? Or does &trans work, because of the conditional layers above? 
                &none   &kp EXCL     &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET   &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &none
                &none  &kp GRAVE  &kp TILDE     &none     &none      &none    &kp MINUS  &kp EQUAL         &kp LBKT  &kp RBKT  &kp BSLH  &none
                &none      &none      &none     &none     &none      &none    &kp UNDER   &kp PLUS         &kp LBRC  &kp RBRC  &kp PIPE  &none
                               &trans  &trans     &trans       &trans     &trans           &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
            //    &mo TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
            //    &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &trans
            //   &bt LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &trans
            //                       &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
                &none        &kp F1        &kp F2        &kp F3      &kp F4            &kp F5        &kp F6        &kp F7        &kp F8  &kp F9  &kp F10  &none
                &none         &none         &none    &kp C_PREV  &kp C_NEXT  &kp C_PLAY_PAUSE    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &none  &kp F11  &none
                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_NXT        &bt BT_CLR         &none         &none         &none   &none  &kp F12  &none
                                     &sys_reset      &trans            &trans        &trans        &trans    &sys_reset
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};